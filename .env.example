# Exemplo de variáveis privadas do Netlify.
# Não coloque valores reais neste arquivo público.
CNJM_ADS_ADMIN_LOGIN=
CNJM_ADS_ADMIN_PASSWORD=
CNJM_ADS_ADMIN_PASSWORD_HASH=
CNJM_ADS_ADMIN_TOKEN=
# URL privada da API de metadados da rádio. Nunca publique o valor no Git.
CNJM_STREAM_METADATA_URL=
# Chave privada de 32 bytes em Base64 ou hexadecimal para cifrar a senha do Vox no Blob.
# Gere uma chave nova por ambiente e nunca reutilize senhas como chave de criptografia.
CNJM_VOX_CREDENTIALS_ENCRYPTION_KEY=
# Opcional: endereço do painel Vox. O padrão é https://vox.svrdedicado.org.
CNJM_VOX_CONTROL_PANEL_URL=
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=
CNJM_STREAM_METADATA_URL=
